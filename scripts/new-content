#!/bin/sh

set -eu

if [ "$#" -ne 2 ]; then
  echo "Usage: ./scripts/new-content <journal|writing|linguistics|research> <slug>" >&2
  exit 1
fi

section="$1"
slug="$2"

case "$section" in
  journal|writing|linguistics|research)
    ;;
  *)
    echo "Error: section must be journal, writing, linguistics, or research" >&2
    exit 1
    ;;
esac

case "$slug" in
  ''|*/*|.*)
    echo "Error: slug must be a non-empty path-safe name" >&2
    exit 1
    ;;
esac

exec hugo new "$section/$slug/index.md"
